digraph ER {
 rankdir=LR; nodesep=0.45; ranksep=1.2; node [shape=plain, fontname="Helvetica"]; edge [fontname="Helvetica", fontsize=10, dir=both, arrowtail=tee, arrowhead=crow];
cliente [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#fffdf8"><tr><td bgcolor="#8a5a31"><font color="white"><b>cliente</b></font></td></tr><tr><td align="left"><b>PK</b> cedula TEXT</td></tr><tr><td align="left">nombre TEXT</td></tr><tr><td align="left">apellidos TEXT</td></tr><tr><td align="left">correo TEXT (único)</td></tr><tr><td align="left">telefono TEXT</td></tr><tr><td align="left">tipo TEXT (Regular|Mayorista|Coleccionista)</td></tr></table>>];
vendedor [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#fffdf8"><tr><td bgcolor="#8a5a31"><font color="white"><b>vendedor</b></font></td></tr><tr><td align="left"><b>PK</b> cedula TEXT</td></tr><tr><td align="left">nombre TEXT</td></tr><tr><td align="left">apellidos TEXT</td></tr><tr><td align="left">correo TEXT (único)</td></tr><tr><td align="left">telefono TEXT</td></tr><tr><td align="left">puesto TEXT</td></tr><tr><td align="left">salario_x_hora REAL</td></tr></table>>];
sucursal [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#fffdf8"><tr><td bgcolor="#b9814f"><font color="white"><b>sucursal</b></font></td></tr><tr><td align="left"><b>PK</b> identificador TEXT</td></tr><tr><td align="left">nombre TEXT</td></tr><tr><td align="left">ubicacion TEXT</td></tr></table>>];
merch [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#fffdf8"><tr><td bgcolor="#b9814f"><font color="white"><b>merch</b></font></td></tr><tr><td align="left"><b>PK</b> identificador TEXT</td></tr><tr><td align="left">nombre TEXT (único)</td></tr><tr><td align="left">precio_x_unidad REAL</td></tr></table>>];
color [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#fffdf8"><tr><td bgcolor="#b9814f"><font color="white"><b>color</b></font></td></tr><tr><td align="left"><b>PK</b> identificador TEXT</td></tr><tr><td align="left">nombre TEXT (único)</td></tr></table>>];
accesorio [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#fffdf8"><tr><td bgcolor="#b9814f"><font color="white"><b>accesorio</b></font></td></tr><tr><td align="left"><b>PK</b> identificador TEXT</td></tr><tr><td align="left">nombre TEXT (único)</td></tr><tr><td align="left">precio_extra REAL</td></tr></table>>];
pedido [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" bgcolor="#fffdf8"><tr><td bgcolor="#c98a4b"><font color="black"><b>pedido</b></font></td></tr><tr><td align="left"><b>PK</b> identificador TEXT</td></tr><tr><td align="left">fecha TEXT</td></tr><tr><td align="left">metodo_pago TEXT (Efectivo|Tarjeta|SINPE)</td></tr><tr><td align="left"><b>FK</b> cliente TEXT</td></tr><tr><td align="left"><b>FK</b> atendido_por TEXT</td></tr><tr><td align="left"><b>FK</b> sucursal TEXT (lugar de retiro)</td></tr><tr><td align="left"><b>FK</b> merch TEXT</td></tr><tr><td align="left">cantidad INTEGER</td></tr><tr><td align="left"><b>FK</b> color TEXT</td></tr><tr><td align="left"><b>FK</b> accesorio TEXT</td></tr><tr><td align="left">monto_total REAL</td></tr></table>>];
 cliente -> pedido [label="1 : N\n(realiza)"];
 vendedor -> pedido [label="1 : N\n(atiende)"];
 sucursal -> pedido [label="1 : N\n(retiro en)"];
 merch -> pedido [label="1 : N\n(tipo de merch)"];
 color -> pedido [label="1 : N\n(color elegido)"];
 accesorio -> pedido [label="1 : N\n(accesorio elegido)"];
}
